# Clave de la API serverless de Roboflow (solo servidor; no usar prefijo VITE_)
ROBOFLOW_API_KEY=
# Opcionales
# ROBOFLOW_POSE_MODEL=coco-pose-detection/3
# ROBOFLOW_OBJECT_MODEL=coco/25

# ---------------------------------------------------------------------------
# Helpdesk omnicanal de Kilora (server/helpdesk). Todas son solo de servidor.
# Sin DATABASE_URL usa memoria con datos de demostración (solo desarrollo).
# DATABASE_URL=postgres://usuario:clave@host:5432/kilora
# Kilo IA (Claude). Sin clave usa el triaje heurístico local.
# ANTHROPIC_API_KEY=
# KILO_AI_MODEL=claude-opus-5-5
# JWT HS256 compartido con la app de Kilora (role: customer | agent | admin).
# HELPDESK_JWT_SECRET=
# WhatsApp Business Cloud API (Meta)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_TEMPLATE_LANG=es
# WHATSAPP_TEAM_TEMPLATE=kilora_escalation_alert
# WHATSAPP_REPLY_TEMPLATE=kilora_case_reply
# Equipo de soporte que recibe las alertas por WhatsApp (E.164, separados por coma)
# SUPPORT_TEAM_WHATSAPP=+56911111111,+56922222222
# KILORA_CONSOLE_URL=https://admin.kilora.cl
# Estado de cuenta/flota para Kilo IA y la consola
# KILORA_ACCOUNTS_API_URL=
# KILORA_SERVICE_TOKEN=
# CRON_SECRET=
